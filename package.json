{
  "name": "chrysalis-engine",
  "version": "1.0.1",
  "private": true,
  "description": "Chrysalis Engine: the AI frontend you can reshape just by asking",
  "type": "module",
  "license": "AGPL-3.0-only",
  "engines": {
    "bun": ">=1.4.0"
  },
  "scripts": {
    "dev": "bun --watch src/index.ts",
    "start": "bun run src/index.ts",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.builder.json && tsc --noEmit -p client/tsconfig.json && cd client-agent && bun run typecheck",
    "test": "bun test test/ --parallel",
    "lint": "biome lint --max-diagnostics=none .",
    "build:client": "bun run scripts/build-frontends.ts",
    "dev:shell": "bun run scripts/dev/shell.ts",
    "dev:agent": "bun run scripts/dev/agent.ts",
    "dist": "bun run scripts/dist.ts"
  },
  "dependencies": {
    "@babel/standalone": "^7.29.8",
    "@earendil-works/pi-agent-core": "^0.85.1",
    "@earendil-works/pi-ai": "^0.85.1",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@jitl/quickjs-ng-wasmfile-release-sync": "^0.32.0",
    "@mayflowergmbh/wasmsh-pyodide": "0.8.0",
    "@modelcontextprotocol/sdk": "^1.12.0",
    "@sebastianwessel/quickjs": "^3.1.0",
    "diff": "8.0.4",
    "diff3": "0.0.3",
    "esbuild": "0.28.2",
    "esbuild-wasm": "0.28.2",
    "fflate": "^0.8.3",
    "hono": "^4.7.0",
    "isomorphic-git": "^1.27.1",
    "quickjs-emscripten-core": "0.32.0",
    "react-refresh": "0.18.0",
    "tailwindcss": "4.1.17",
    "tw-animate-css": "1.4.0",
    "typebox": "^1.3.7",
    "uqr": "0.1.3",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@base-ui/react": "^1.7.0",
    "@biomejs/biome": "2.5.13",
    "@lobehub/icons-static-svg": "^1.95.0",
    "@phosphor-icons/react": "^2.1.10",
    "@types/bun": "^1.4.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@types/ws": "^8.18.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwind-merge": "^3.6.0",
    "typescript": "^5.8.0",
    "zod": "^4.4.3"
  },
  "repository": "https://github.com/ProjectChrysalis/Chrysalis-Engine"
}
